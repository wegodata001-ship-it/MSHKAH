rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath());
    }

    function userExists() {
      return isSignedIn() && exists(userPath());
    }

    function isActiveUser() {
      return userExists() && userDoc().data.get('active', true) != false;
    }

    function isStaff() {
      return isActiveUser() && userDoc().data.role in ['Admin', 'Manager', 'Employee'];
    }

    function isAdmin() {
      return isActiveUser() && userDoc().data.role == 'Admin';
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /customers/{id} {
      allow read: if isStaff() || id == 'guest-checkout';
      allow create: if isStaff() || id == 'guest-checkout';
      allow update: if isStaff() || id == 'guest-checkout';
      allow delete: if isStaff();
    }

    match /orders/{id} {
      allow read: if isStaff();
      allow create: if true;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /ui_translations/{locale} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /assistant/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }

    match /connection-test/{id} {
      allow read, write: if true;
    }

    match /modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /modifier_options/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_modifier_options/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /business_rules/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /suggestions/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /inventory_links/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pdfMenuTemplates/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuCategorySettings/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuProductSettings/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuPages/{id} {
      allow read, write: if isStaff();
    }

    match /printJobs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /printAgentHeartbeats/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /ingredients/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ingredientCategories/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /purchaseUnits/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /dishRecipes/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /productCostLinks/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /ingredientPriceHistory/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /costingSettings/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /costingSnapshots/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /costingImportHistory/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /breakEvenFixedCosts/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /breakEvenVariableCosts/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /breakEvenSettings/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /breakEvenSnapshots/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /supplierPayments/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /supplierOpenings/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /supplierOffers/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /purchaseInvoices/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /supplierItemMaps/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /purchasePriceRecords/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /inventoryMovements/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /inventoryBalances/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posImports/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.kind == 'excel-info'
        && request.resource.data.infoOnly == true
        && request.resource.data.financeStatus == 'none';
      allow delete: if false;
    }

    match /posProductMaps/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posColumnMaps/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posZReports/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin() && resource.data.status == 'draft' && request.resource.data.status == 'draft';
      allow delete: if false;
    }

    match /posFinanceEntries/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /stockCounts/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /stockCountSessions/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cashFlowEntries/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /cashFlowSettings/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /reportRuns/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Audit log for dish-pricing changes (price / manual cost / verification
    // flips). Written only by the admin API route, read-only for admins so
    // the UI can show change history without granting write access.
    match /productChangeHistory/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /salesAiReports/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // Loyalty club. All customer-facing writes go through server
    // API routes using the Admin SDK (bypassing these rules), so the
    // client-side rules are deliberately restrictive.
    // ─────────────────────────────────────────────────────────────
    match /loyaltySettings/{id} {
      // Storefront reads the public shape via `/api/club/me` (server-side),
      // so Firestore itself is admin-only. Writes also admin-only.
      allow read, write: if isAdmin();
    }

    match /loyaltyMembers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /loyaltyPointsLedger/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /loyaltyEnrollmentTokens/{id} {
      // Never readable from the client — would leak codes.
      allow read, write: if false;
    }

    match /loyaltyRateLimit/{id} {
      allow read, write: if false;
    }
  }
}
