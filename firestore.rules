rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath());
    }

    function userExists() {
      return isSignedIn() && exists(userPath());
    }

    function isActiveUser() {
      return userExists() && userDoc().data.active == true;
    }

    function isStaff() {
      return isActiveUser() && userDoc().data.role in ['Admin', 'Manager', 'Employee'];
    }

    function isAdmin() {
      return isActiveUser() && userDoc().data.role == 'Admin';
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /customers/{id} {
      allow read: if isStaff() || id == 'guest-checkout';
      allow create: if isStaff() || id == 'guest-checkout';
      allow update: if isStaff() || id == 'guest-checkout';
      allow delete: if isStaff();
    }

    match /orders/{id} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /ui_translations/{locale} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /assistant/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }

    match /connection-test/{id} {
      allow read, write: if true;
    }

    match /modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /modifier_options/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_modifier_options/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /business_rules/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /suggestions/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /inventory_links/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pdfMenuTemplates/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuCategorySettings/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuProductSettings/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuPages/{id} {
      allow read, write: if isStaff();
    }

    match /printJobs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /printAgentHeartbeats/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /ingredients/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /dishRecipes/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ingredientPriceHistory/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /costingSettings/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /costingSnapshots/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
